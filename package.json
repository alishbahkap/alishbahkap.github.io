{
  "name": "alishbah-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:clean": "npm run clean && next dev --hostname 127.0.0.1",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "audit": "npm audit --audit-level=high",
    "clean": "node -e \"for (const d of ['.next', 'out']) require('fs').rmSync(d, { recursive: true, force: true })\""
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "flatted": "3.4.2",
    "postcss": "8.5.19"
  }
}
